# MENRUT — Cabeceras de Cloudflare Pages (exportación estática)
# Recursos con hash en el nombre: inmutables un año.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Marca e iconos: semana.
/brand/*
  Cache-Control: public, max-age=604800
/menrut/icons/*
  Cache-Control: public, max-age=604800

# Manifest: una hora.
/menrut/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Shell HTML: siempre revalidar.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Service Worker y página offline: siempre revalidar (nunca caché vieja).
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/offline.html
  Cache-Control: public, max-age=0, must-revalidate

# Versión de la compilación: siempre consultar en red (aviso de actualización).
/version.json
  Cache-Control: no-store
