# MENRUT — Cabeceras de Cloudflare Pages (exportación estática)
# Recursos con hash en el nombre: inmutables un año.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Marca e iconos: semana.
/brand/*
  Cache-Control: public, max-age=604800
/menrut/icons/*
  Cache-Control: public, max-age=604800

# Manifest: una hora.
/menrut/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Shell HTML: siempre revalidar.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
